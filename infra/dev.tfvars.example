# Copy to dev.tfvars and adjust, then:
#   terraform plan  -var-file=dev.tfvars
#   terraform apply -var-file=dev.tfvars

app_name = "todo-app"
env      = "dev"

# Frontend origin allowed by CORS. Keep as the real CloudFront/custom domain once
# known (e.g. "https://d1234.cloudfront.net"); "*" is only acceptable pre-frontend.
allowed_origin = "*"
