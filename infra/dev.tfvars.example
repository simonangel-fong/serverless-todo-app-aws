# Copy to dev.tfvars and adjust, then:
#   terraform plan  -var-file=dev.tfvars
#   terraform apply -var-file=dev.tfvars

app_name = "todo-app"
env      = "dev"

# S3 bucket holding Terraform state (matches backend.hcl); grants the CI/CD
# deploy role access to state. Leave "" to skip that policy.
state_bucket = ""

# NOTE: cloudflare_api_token is required but must NOT go here. Supply it via the
# environment so it stays out of version control:
#   export TF_VAR_cloudflare_api_token=...   (bash)
#   $env:TF_VAR_cloudflare_api_token="..."   (PowerShell)
